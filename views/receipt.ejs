<!DOCTYPE html>
<html>
<head>
    <title>Payment Receipt</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body{
            font-family: Arial, sans-serif;
            margin: 30px;
        }

        .receipt{
            width: 700px;
            margin: auto;
            border: 2px solid black;
            padding: 20px;
        }

        h1,h2{
            text-align: center;
        }

        table{
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        table, th, td{
            border: 1px solid black;
        }

        th, td{
            padding: 10px;
            text-align: left;
        }

        .total{
            font-weight: bold;
        }

        .btn{
            padding: 10px 15px;
            text-decoration: none;
            background-color: green;
            color: white;
            border-radius: 5px;
        }

    </style>
</head>

<body>

<div class="receipt">

    <h1>Rentify</h1>

    <h2>Payment Receipt</h2>

    <p>
        <strong>Receipt No:</strong>
        <%= payment.receiptNumber %>
    </p>

    <p>
        <strong>Date:</strong>
        <%= new Date(payment.paymentDate).toLocaleDateString() %>
    </p>

    <hr>

    <h3>Tenant Details</h3>

    <p>
        <strong>Name:</strong>
        <%= payment.bill.tenant.name %>
    </p>

    <hr>

    <h3>Bill Details</h3>

    <table>

        <tr>
            <th>Rent</th>
            <td>₹ <%= payment.bill.rent %></td>
        </tr>

        <tr>
            <th>Electricity Bill</th>
            <td>₹ <%= payment.bill.electricityBill %></td>
        </tr>

        <tr>
            <th>Water Charge</th>
            <td>₹ <%= payment.bill.waterCharge %></td>
        </tr>

        <tr>
            <th>Previous Balance</th>
            <td>₹ <%= payment.bill.previousBalance %></td>
        </tr>

        <tr class="total">
            <th>Total Bill</th>
            <td>₹ <%= payment.bill.totalBill %></td>
        </tr>

    </table>

    <br>

    <h3>Payment Information</h3>

    <table>

        <tr>
            <th>Amount Paid</th>
            <td>₹ <%= payment.amount %></td>
        </tr>

        <tr>
            <th>Payment Mode</th>
            <td><%= payment.paymentMode %></td>
        </tr>

        <tr>
            <th>Remaining Balance</th>
            <td>₹ <%= payment.bill.balance %></td>
        </tr>

        <tr>
            <th>Status</th>
            <td><%= payment.bill.status %></td>
        </tr>

    </table>

    <br><br>

    <a href="/bills" class="btn">
        Back To Bills
    </a>

    <button onclick="window.print()" class="btn">
        Print Receipt
    </button>

</div>

</body>
</html>