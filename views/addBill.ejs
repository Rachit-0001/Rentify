<link rel="stylesheet" href="/css/style.css">
<h1>Generate Bill</h1>

<form action="/bill/add" method="POST">

    <select name="tenantId">

        <% tenants.forEach(t => { %>

            <option value="<%= t._id %>">
                <%= t.name %> -
                <%= t.property.propertyNumber %>
            </option>

        <% }) %>

    </select>

    <br><br>

    <input type="text" name="month" placeholder="Month">

    <br><br>

    <input type="number" name="year" placeholder="Year">

    <br><br>

    <input type="number" name="previousReading" placeholder="Previous Reading">

    <br><br>

    <input type="number" name="currentReading" placeholder="Current Reading">

    <br><br>

    <input type="number" name="electricityRate" placeholder="Rate per Unit">

    <br><br>

    <button type="submit">
        Generate Bill
    </button>

</form> 